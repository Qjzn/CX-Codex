{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Quiet, compact conversation surface for a coding agent; restrained neutrals, one teal accent, three text sizes, four spacing steps.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.122,
          0.122,
          0.122
        ],
        "hex": "#1f1f1f"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.373,
          0.373,
          0.361
        ],
        "hex": "#5f5f5c"
      }
    },
    "tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.435,
          0.435,
          0.424
        ],
        "hex": "#6f6f6c"
      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.969,
          0.969,
          0.965
        ],
        "hex": "#f7f7f6"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.89,
          0.89,
          0.875
        ],
        "hex": "#e3e3df"
      }
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.059,
          0.463,
          0.431
        ],
        "hex": "#0f766e"
      }
    },
    "warning": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.604,
          0.404,
          0
        ],
        "hex": "#9a6700"
      }
    },
    "danger": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.761,
          0.255,
          0.047
        ],
        "hex": "#c2410c"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 10,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "pill": {
      "$value": {
        "value": 999,
        "unit": "px"
      }
    }
  },
  "typography": {
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "PingFang SC",
        "fontSize": {
          "value": 14,
          "unit": "px"
        },
        "fontWeight": 400
      }
    },
    "status": {
      "$type": "typography",
      "$value": {
        "fontFamily": "PingFang SC",
        "fontSize": {
          "value": 13,
          "unit": "px"
        },
        "fontWeight": 400
      }
    },
    "meta": {
      "$type": "typography",
      "$value": {
        "fontFamily": "PingFang SC",
        "fontSize": {
          "value": 12,
          "unit": "px"
        },
        "fontWeight": 400
      }
    },
    "title": {
      "$type": "typography",
      "$value": {
        "fontFamily": "PingFang SC",
        "fontSize": {
          "value": 14,
          "unit": "px"
        },
        "fontWeight": 650
      }
    },
    "code": {
      "$type": "typography",
      "$value": {
        "fontFamily": "JetBrains Mono",
        "fontSize": {
          "value": 12.5,
          "unit": "px"
        },
        "fontWeight": 400
      }
    }
  }
}
